FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
    volVectorFieldValue U (0 0 0)
);

// Still water to z = 1 m
regions
(
    boxToCell
    {
        box (-1 -1 -1) (100 100 1.0);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);

