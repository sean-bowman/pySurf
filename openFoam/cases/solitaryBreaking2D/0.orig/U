FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // The wave maker: velocity of the solitary wave entering, with active absorption of what returns
    inlet
    {
        type            waveVelocity;
        value           uniform (0 0 0);
    }

    // Shallow water absorption of the broken wave
    outlet
    {
        type            waveVelocity;
        value           uniform (0 0 0);
    }

    // Free slip, as the inviscid reference assumes; the boundary layer is far below this mesh
    bottom
    {
        type            slip;
    }

    atmosphere
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    sides
    {
        type            empty;
    }
}

